# ===== MuseTalk environment variables (PLACEHOLDERS ONLY — never commit real values) =====
# Set these in Netlify: Site settings → Environment variables
# And locally in a file called .env (which is git-ignored)

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY-server-only-never-share
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Auth — generate a long random string (32+ chars), e.g. with: openssl rand -hex 32
JWT_SECRET=REPLACE-WITH-A-LONG-RANDOM-SECRET

# Google Drive archive (owner account = your Google account)
# See README step 2 for the exact OAuth clicks. Run: npm run google-auth
GOOGLE_CLIENT_ID=YOUR-GOOGLE-OAUTH-CLIENT-ID
GOOGLE_CLIENT_SECRET=YOUR-GOOGLE-OAUTH-CLIENT-SECRET
GOOGLE_REFRESH_TOKEN=YOUR-GOOGLE-REFRESH-TOKEN-server-only
# Optional: set after first sync if you want to pin the folder ID
GOOGLE_DRIVE_FOLDER_ID=
